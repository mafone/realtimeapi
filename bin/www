#!/usr/bin/env node

/**
 * Module dependencies.
 */

var app = require('../app');
var debug = require('debug')('realtimeapi-angosoftwares:server');
var http = require('http');
const https = require('https'); //Using the https module to be used with our certificate

const fetch = require('node-fetch'); ////Import the package to fetch data

const fs= require('fs'); //Using file system module
const options = { //Begin options for https
  key: fs.readFileSync('./.cert/angola_sytes_net.key', 'utf8'),
  cert: fs.readFileSync('./.cert/angola_sytes_net.pem', 'utf8'),
  //requestCert: false, //DO not request cert to any application connected to this. TODO: change this for production
  //rejectUnauthorized: false, //DO not reject self-signed certificate from any application connected to this. TODO: change this for production
} //End options for https

/**
 * Get port from environment and store in Express.
 */

var port = normalizePort(process.env.PORT || '8082');
app.set('port', port);

/**
 * Create HTTP (+TLS) server.
 */

//var server = http.createServer(app);
process.env.NODE_TLS_REJECT_UNAUTHORIZED="0"; //Allow self signed certificate to remote. TODO: change this for production

const hosts = require('../hosts');
const server = https.createServer(options, app);
const io = require('socket.io')(server, {
  cors: {
    origin: "*",
    methods: ["GET", "POST"]
  }
})

//Begin socket.on
io.on('connection', (client) => { //Open the socket connection
  /************************************************************BEGIN GETS***************************************************************************************************************************** */
