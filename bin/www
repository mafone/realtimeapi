    console.log ('##################GetPostPutDelete##################');
    //console.log("genericEntidades -> Data = ", data1);
    //console.log ('listen -> ', data1.listenMessage)
    //console.log("genericEntidades -> Data To Send = ", data1.data_to_send);
    console.log("#######################genericEntidades -> ID = ", data1.data_to_send);
    console.log("#######################genericEntidades -> ID = ", data1.data_to_send);
    console.log("#######################genericEntidades -> ID = ", data1.data_to_send);
    console.log("#######################genericEntidades -> ID = ", data1.data_to_send);
    console.log("#######################genericEntidades -> ID = ", data1.data_to_send);
    console.log("#######################genericEntidades -> ID = ", data1.data_to_send);
    console.log("#######################genericEntidades -> ID = ", data1.data_to_send);
    console.log("#######################genericEntidades -> ID = ", data1.data_to_send);

    // TODO: change the way this is sent not to lose chars
    fetch("https://" + hosts.ango_restapi+'/'+data1.route, {
      method: 'POST', //method: 'DELETE',
      /*Not necessary*/
      headers: {
        'Accept': 'application/json',
        'Content-Type': 'application/json',
      },
      body: JSON.stringify({
        //id: id1, //Not necessary for node rest
        data: data1,
        token: token1, //TODO: this permissions should be inside data1
        component: component1 //TODO: this permissions should also be inside data1
      })
    })
      .then(response => response.json()) //Parsing the post response to json
      .then(responseJson => { //Using the result as a promise
        if ((data1.operation !== 'SelectAll') && (data1.operation !== 'SelectOne')){ //TODO: Without Internal server error????
          console.log("################# -> ", responseJson)
          console.log("################# -> ", responseJson)
          console.log("################# -> ", responseJson)
          console.log("################# -> ", responseJson)
          console.log("################# -> ", responseJson)
          console.log("################# -> ", responseJson)
          console.log("################# -> ", responseJson)
          console.log("################# -> ", responseJson)
          console.log("################# -> ", responseJson)
          console.log("################# -> ", responseJson)
          if(responseJson.data.status == 200){
            console.log('Atualizar tabela ... ');
            //Case the operation above is not SelectAll, we need to select updated data below
            dataSend = {'route':data1.route, listenMessage: data1.listenMessage, 'operation': 'SelectAll' , 'data_to_send':[{'table':data1.data_to_send[0].table, 'fields':[], 'values':[], 'id':{}}]};
            fetch("https://" + hosts.ango_restapi+'/'+data1.route, { //POST fetch for any route/table
              method: 'POST',
              headers: {
                'Accept': 'application/json',
                'Content-Type': 'application/json',
              },
              body: JSON.stringify({
                data: dataSend,
                token: token1, //TODO: this permissions should be inside data1
                component: component1 //TODO: this permissions should also be inside data1
              })
            })
              .then((response) => response.json()) //Parsing the post response to json
              .then((responseJson) => { //waiting for the promise in this callback
                io.emit(dataSend.listenMessage, responseJson); //The requester will receive the error
              })
              .catch((error) => { //Error during POST
                console.error(error);
                io.emit(dataSend.listenMessage, {"error": responseJson.error }); //The requester will receive the error
              });
          }
          else{//Internal server error
            io.emit(data1.listenMessage, responseJson); 
          }
        }
        else{
          console.log('Checking response status ... ');
          jsonResponse = JSON.parse(responseJson)
          console.log(jsonResponse)
          if(jsonResponse.data.status == 200){
            console.log('buscarDados tabela ... ');
            io.emit(data1.listenMessage, responseJson); //The requester will receive the error
          }
          else{//Internal server error
            console.log('Erro...');
            console.log(responseJson);
            io.emit(data1.listenMessage, responseJson); 
          }
        }
      })
      .catch((error) => { //Handle any other exception during POST
        console.log("##############################", "https://" + hosts.ango_restapi+'/'+data1.route)
        console.log ("error -> ", error)
        io.emit(data1.listenMessage, {"error": error });
      });
  });
});//End socket.on

server.listen(port);
// server.on('error', onError);
// server.on('listening', onListening);

/**
 * Normalize a port into a number, string, or false.
 */

function normalizePort(val) {
  var port = parseInt(val, 10);

  if (isNaN(port)) {
    // named pipe
    return val;
  }

  if (port >= 0) {
    // port number
    return port;
  }

  return false;
}

/**
 * Event listener for HTTP server "error" event.
 */

function onError(error) {
  if (error.syscall !== 'listen') {
    throw error;
  }

  var bind = typeof port === 'string'
    ? 'Pipe ' + port
    : 'Port ' + port;

  // handle specific listen errors with friendly messages
  switch (error.code) {
    case 'EACCES':
      console.error(bind + ' requires elevated privileges');
      process.exit(1);
      break;
    case 'EADDRINUSE':
      console.error(bind + ' is already in use');
      process.exit(1);
      break;
    default:
      throw error;
  }
}

/**
 * Event listener for HTTP server "listening" event.
 */

function onListening() {
  var addr = server.address();
  var bind = typeof addr === 'string'
    ? 'pipe ' + addr
    : 'port ' + addr.port;
  debug('Listening on ' + bind);
}
