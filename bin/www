#!/usr/bin/env node

/**
 * Module dependencies.
 */

var app = require('../app');
var debug = require('debug')('realtimeapi-angosoftwares:server');
//var http = require('http');
const https = require('https'); //Using the https module to be used with our certificate

const fs= require('fs'); //Using file system module
const options = { //Begin options for https
  key: fs.readFileSync('./angosoftwares_cert/server.key', 'utf8'),
  cert: fs.readFileSync('./angosoftwares_cert/server.crt', 'utf8'),
  //requestCert: false, //DO not request cert to any application connected to this. TODO: change this for production
  //rejectUnauthorized: false, //DO not reject self-signed certificate from any application connected to this. TODO: change this for production
} //End options for https

/**
 * Get port from environment and store in Express.
 */

var port = normalizePort(process.env.PORT || '8082');
app.set('port', port);

/**
 * Create HTTP (+TLS) server.
 */

//var server = http.createServer(app);
process.env.NODE_TLS_REJECT_UNAUTHORIZED="0"; //Allow self signed certificate to remote. TODO: change this for production
var server = https.createServer(options, app); //Intantiating the server with the https module defined rather than simple http

/**
 * Listen on provided port, on all network interfaces.
 */

server.listen(port);
server.on('error', onError);
server.on('listening', onListening);

/**
 * Normalize a port into a number, string, or false.
 */

function normalizePort(val) {
  var port = parseInt(val, 10);

  if (isNaN(port)) {
    // named pipe
    return val;
  }

  if (port >= 0) {
    // port number
    return port;
  }

  return false;
}

/**
 * Event listener for HTTP server "error" event.
 */

function onError(error) {
  if (error.syscall !== 'listen') {
    throw error;
  }

  var bind = typeof port === 'string'
    ? 'Pipe ' + port
    : 'Port ' + port;

  // handle specific listen errors with friendly messages
  switch (error.code) {
    case 'EACCES':
      console.error(bind + ' requires elevated privileges');
      process.exit(1);
      break;
    case 'EADDRINUSE':
      console.error(bind + ' is already in use');
      process.exit(1);
      break;
    default:
      throw error;
  }
}

/**
 * Event listener for HTTP server "listening" event.
 */

function onListening() {
  var addr = server.address();
  var bind = typeof addr === 'string'
    ? 'pipe ' + addr
    : 'port ' + addr.port;
  debug('Listening on ' + bind);
}
